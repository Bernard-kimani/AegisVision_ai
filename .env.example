# Copy this file to .env and fill in your real keys. Never commit .env.
# Pick a provider in the Controls tab (llm.provider) to match whichever key you set below.

# Open-weights path (recommended): Qwen2.5-VL / DeepSeek-V3/R1 via any
# OpenAI-compatible endpoint - Fireworks AI, SiliconFlow, DashScope, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Proprietary fallback
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
